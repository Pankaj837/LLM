{
  "train": {
    "train_bin": "data/quant/train.bin",
    "val_bin": "data/quant/val.bin",
    "vocab": "data/quant/vocab.tok",
    "out_dir": "runs/quant_small",
    "preset": "small",
    "seq_len": 256,
    "batch_size": 16,
    "grad_accum": 1,
    "max_steps": 900,
    "lr": 0.002,
    "min_lr_ratio": 0.1,
    "warmup_steps": 100,
    "weight_decay": 0.1,
    "beta1": 0.9,
    "beta2": 0.95,
    "grad_clip": 1.0,
    "eval_interval": 50,
    "eval_batches": 20,
    "save_interval": 100,
    "log_interval": 25,
    "seed": 0,
    "device": "auto",
    "dtype": "auto",
    "resume": "runs/quant_small/ckpt_last.pt",
    "stop_step": null,
    "model_overrides": {}
  },
  "model": {
    "vocab_size": 8000,
    "hidden_dim": 256,
    "num_layers": 6,
    "num_query_heads": 8,
    "num_kv_heads": 2,
    "head_dim": 32,
    "intermediate_dim": 704,
    "max_position_embeddings": 512,
    "rope_theta": 10000.0,
    "use_yarn": false,
    "yarn_scale_factor": 1.0,
    "yarn_original_max_position": 512,
    "yarn_beta_fast": 32.0,
    "yarn_beta_slow": 1.0,
    "use_dynamic_ntk": false,
    "attention_dropout": 0.0,
    "rms_norm_eps": 1e-06
  }
}